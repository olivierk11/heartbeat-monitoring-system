<mxfile host="app.diagrams.net">
  <diagram id="arch" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Real-Time Customer Heart Beat Monitoring System&lt;/b&gt; - data flow" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1B2A2F;" vertex="1" parent="1">
          <mxGeometry x="240" y="10" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="docker" value="Docker Compose (docker-compose.yml)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeColor=#8A9AA0;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#8A9AA0;fontStyle=2;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="600" height="470" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="&lt;b style='font-size:14px'&gt;Data generator&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5B6B70'&gt;data_generator.py&lt;br&gt;random-walk heart rate&lt;br&gt;per-customer baseline, anomaly episodes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontColor=#1B2A2F;fontSize=12;verticalAlign=middle;fillColor=#E3F0FB;strokeColor=#2C6E9E;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="prod" value="&lt;b style='font-size:14px'&gt;Kafka producer&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5B6B70'&gt;producer.py&lt;br&gt;key = customer_id&lt;br&gt;acks=all, idempotent&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontColor=#1B2A2F;fontSize=12;verticalAlign=middle;fillColor=#E3F0FB;strokeColor=#2C6E9E;" vertex="1" parent="1">
          <mxGeometry x="20" y="330" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="kafka" value="&lt;b style='font-size:14px'&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5B6B70'&gt;topic: heartbeat-readings&lt;br&gt;3 partitions, JSON messages&lt;br&gt;localhost:9092&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontColor=#1B2A2F;fontSize=12;verticalAlign=middle;fillColor=#FFF1DE;strokeColor=#B86E00;" vertex="1" parent="1">
          <mxGeometry x="330" y="120" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="zk" value="&lt;b style='font-size:14px'&gt;Zookeeper&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5B6B70'&gt;cluster coordination&lt;br&gt;:2181&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontColor=#1B2A2F;fontSize=12;verticalAlign=middle;fillColor=#FFF1DE;strokeColor=#B86E00;" vertex="1" parent="1">
          <mxGeometry x="330" y="380" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b style='font-size:14px'&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5B6B70'&gt;heartbeat_readings&lt;br&gt;(indexed on reading_time)&lt;br&gt;invalid_readings&lt;br&gt;view: latest_heartbeat&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;strokeWidth=2;fontColor=#1B2A2F;fontSize=12;fillColor=#E4F4EC;strokeColor=#2E7D55;" vertex="1" parent="1">
          <mxGeometry x="630" y="300" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="grafana" value="&lt;b style='font-size:14px'&gt;Grafana (optional)&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5B6B70'&gt;:3000&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontColor=#1B2A2F;fontSize=12;verticalAlign=middle;fillColor=#F6E7EF;strokeColor=#9C3D6B;" vertex="1" parent="1">
          <mxGeometry x="630" y="120" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cons" value="&lt;b style='font-size:14px'&gt;Kafka consumer&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5B6B70'&gt;consumer.py&lt;br&gt;1. parse JSON&lt;br&gt;2. validate fields and range&lt;br&gt;3. classify normal / low / high&lt;br&gt;4. bulk insert, then commit offsets&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontColor=#1B2A2F;fontSize=12;verticalAlign=middle;fillColor=#E3F0FB;strokeColor=#2C6E9E;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="250" height="160" as="geometry" />
        </mxCell>
        <mxCell id="st" value="&lt;b style='font-size:14px'&gt;Streamlit dashboard&lt;/b&gt;&lt;br&gt;&lt;span style='color:#5B6B70'&gt;dashboard.py&lt;br&gt;:8501&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=2;fontColor=#1B2A2F;fontSize=12;verticalAlign=middle;fillColor=#F6E7EF;strokeColor=#9C3D6B;" vertex="1" parent="1">
