# Copy to .env and adjust if needed
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=heartbeat-readings
KAFKA_CONSUMER_GROUP=heartbeat-db-writer

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=heartbeat
POSTGRES_USER=heartbeat
POSTGRES_PASSWORD=heartbeat

# Readings outside this range are physically implausible -> rejected
HR_MIN_VALID=30
HR_MAX_VALID=220
# Valid readings outside this range are flagged as anomalies (low/high)
HR_LOW_THRESHOLD=50
HR_HIGH_THRESHOLD=120
